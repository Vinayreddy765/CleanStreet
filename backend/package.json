{
  "name": "cleanstreet-backend",
  "version": "1.0.0",
  "description": "CleanStreet backend Lambda functions",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "seed": "ts-node src/seed.ts",
    "seed:compiled": "node dist/seed.js",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.540.0",
    "@aws-sdk/client-s3": "3.540.0",
    "@aws-sdk/lib-dynamodb": "3.540.0",
    "@aws-sdk/s3-request-presigner": "3.540.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.136",
    "@types/jest": "29.5.12",
    "@types/node": "20.11.30",
    "@types/uuid": "9.0.8",
    "esbuild": "0.20.2",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "typescript": "5.4.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"]
  }
}
